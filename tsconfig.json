{
  "compilerOptions": {
    "paths": {
      "medhira-rn-expo-json-ui-engine": ["./src/index"]
    },

    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "jsx": "react-native",

    "strict": true,
    "noEmit": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "useDefineForClassFields": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "lib",
    "example",
    "android",
    "ios",
    "**/__tests__/**"
  ]
}